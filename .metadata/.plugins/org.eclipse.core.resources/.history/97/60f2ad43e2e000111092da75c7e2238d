package com.ecommerce.inventory;

import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.test.context.ActiveProfiles;

import com.ecommerce.inventory.entity.Inventory;
import com.ecommerce.inventory.repository.InventoryRepository;
import com.ecommerce.inventory.service.InventoryService;

import static org.junit.jupiter.api.Assertions.assertEquals;

import java.util.concurrent.CountDownLatch;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;
import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.AtomicInteger;

@SpringBootTest
@ActiveProfiles("test") // Ye Step 2 wali application-test.properties ko load karega

public class InventoryConcurrencyTest {
	@Autowired
	private InventoryRepository inventoryRepo;
	private InventoryService inventoryService;// Ye add karein

	@Test
	void testDistributedLockOnConcurrentReservations() throws InterruptedException {
	    String testSku = "LAPTOP001";

	    // 1. Test shuru hone se pehle DB mein actual stock check karein
	    Inventory initialInv = inventoryRepo.findBySkuCode(testSku).orElseThrow();
	    System.out.println("=== TEST START: Initial Available Stock = " + initialInv.getAvailableQuantity() + " ===");

	    int numberOfThreads = 10;
	    ExecutorService executorService = Executors.newFixedThreadPool(numberOfThreads);
	    CountDownLatch latch = new CountDownLatch(1);

	    AtomicInteger successCount = new AtomicInteger(0);
	    AtomicInteger failureCount = new AtomicInteger(0);

	    for (int i = 1; i <= numberOfThreads; i++) {
	        final String orderId = "TEST-ORDER-" + i;
	        executorService.submit(() -> {
	            try {
	                latch.await();
	                inventoryService.reserve(orderId, testSku, 1);
	                System.out.println(Thread.currentThread().getName() + " -> SUCCESS for " + orderId);
	                successCount.incrementAndGet();
	            } catch (Exception e) {
	                System.out.println(Thread.currentThread().getName() + " -> FAILED for " + orderId + " | Reason: " + e.getMessage());
	                failureCount.incrementAndGet();
	            }
	        });
	    }

	    latch.countDown();
	    executorService.shutdown();
	    executorService.awaitTermination(15, TimeUnit.SECONDS);

	    // 2. Test khatam hone ke baad DB mein final stock check karein
	    Inventory finalInv = inventoryRepo.findBySkuCode(testSku).orElseThrow();
	    System.out.println("=== TEST END: Final Available Stock = " + finalInv.getAvailableQuantity() + " ===");
	    System.out.println("Total Successful Reservations: " + successCount.get());
	    System.out.println("Total Failed Reservations: " + failureCount.get());

	    assertEquals(1, successCount.get(), "Sirf 1 reservation succeed honi chahiye!");
	    assertEquals(9, failureCount.get(), "Baaki 9 reservations fail honi chahiye!");
	}
}
