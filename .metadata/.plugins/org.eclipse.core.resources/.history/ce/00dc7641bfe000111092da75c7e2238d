package com.ecommerce.inventory;

import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.test.context.ActiveProfiles;

import com.ecommerce.inventory.service.InventoryService;

import java.util.concurrent.CountDownLatch;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;
import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.AtomicInteger;

@SpringBootTest
@ActiveProfiles("test") // Ye Step 2 wali application-test.properties ko load karega

public class InventoryConcurrencyTest {
	  @Autowired
	    private InventoryService inventoryService; // Aapki asli service class

	    @Test
	    void testDistributedLockOnConcurrentReservations() throws InterruptedException {
	        // 1. Setup: Maan lijiye database mein 'SKU-101' ka available stock sirf 1 hai
	        String testSku = "SKU-101"; 
	        int numberOfThreads = 10; // Hum 10 concurrent users simulate kar rahe hain

	        ExecutorService executorService = Executors.newFixedThreadPool(numberOfThreads);
	        CountDownLatch latch = new CountDownLatch(1); // Sabhi threads ko ek saath start karne ke liye

	        AtomicInteger successCount = new AtomicInteger(0);
	        AtomicInteger failureCount = new AtomicInteger(0);

	        // 2. 10 threads ready karein jo ek hi time par stock reserve karenge
	        for (int i = 1; i <= numberOfThreads; i++) {
	            final String orderId = "TEST-ORDER-" + i;
	            executorService.submit(() -> {
	                try {
	                    latch.await(); // Yahan sabhi threads ruk kar signal ka wait karenge
	                    
	                    // Yahan apna actual reservation method call karein
	                    inventoryService.reserve(orderId, testSku, null);
	                    
	                    successCount.incrementAndGet(); // Agar reserve ho gaya toh count badhayein
	                } catch (Exception e) {
	                    failureCount.incrementAndGet(); // Agar out-of-stock ya lock error aaya toh fail count badhayein
	                }
	            });
	        }

	        // 3. Sabhi 10 threads ko ek hi millisecond par chhod dein!
	        latch.countDown();

	        // 4. Sabhi threads ke khatam hone ka wait karein
	        executorService.shutdown();
	        executorService.awaitTermination(15, TimeUnit.SECONDS);

	        // 5. Results print aur verify karein
	        System.out.println("Total Successful Reservations: " + successCount.get());
	        System.out.println("Total Failed Reservations: " + failureCount.get());

	        // Kyunki stock sirf 1 tha, toh sirf 1 order pass hona chahiye aur 9 fail hone chahiye
	        assertEquals(1, successCount.get(), "Sirf 1 reservation succeed honi chahiye!");
	        assertEquals(9, failureCount.get(), "Baaki 9 reservations fail honi chahiye!");
	    }
}
